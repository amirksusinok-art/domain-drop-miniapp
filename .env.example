NODE_ENV=development
PORT=3001
APP_URL=http://localhost:5173
# Local development can use persistent embedded PostgreSQL (PGlite).
# Production MUST use a PostgreSQL connection string.
DATABASE_URL=
# Optional namespace when sharing a PostgreSQL database. Only lowercase SQL identifiers.
DATABASE_SCHEMA=public
DEV_AUTH=true
BOT_TOKEN=
BOT_USERNAME=
BOT_AUTO_SETUP=false
ADMIN_TELEGRAM_IDS=123456789
WEBHOOK_SECRET=
SUPPORT_USERNAME=
